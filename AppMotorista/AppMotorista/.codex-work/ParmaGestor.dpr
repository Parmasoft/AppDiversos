var
  Handle: HWND;
  ArquivoINI : TIniFile;
  vPodeAbrirEXE: string;

begin
  Application.Initialize;

  Handle := FindWindow('TFrmPrincipal', nil);

  ArquivoINI := TIniFile.Create(ExtractFilePath(Application.ExeName) + 'Conf.INI');
  try
    vPodeAbrirEXE := ArquivoINI.ReadString('CONFIGURACAO', 'VariosEXE', 'S');
  finally
    ArquivoINI.Free;
  end;

  if (vPodeAbrirEXE = 'N') then
  begin
    if (Handle <> 0) then
    begin
      MessageDlg('Backup, já esta em execução.', mtWarning, [mbOK], 0);
      if not ISWindowVisible(Handle) then
        showWindow (Handle, sw_restore);
