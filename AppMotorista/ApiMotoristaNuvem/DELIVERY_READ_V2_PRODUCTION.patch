+            return_contract_version, return_payload_hash, return_state, return_attempt_count
+        ) VALUES (
+            :tenant_id, :operation_guid, :driver_guid, :manifest_guid, :stop_id, :order_id,
+            :request_hash, CAST(:request_json AS jsonb), CAST(:response_json AS jsonb), :created_at,
+            1, :request_hash, 'PENDING', 0
+        )
+    """), {
+        **values,
+        "request_json": json.dumps(values["request_json"]),
+        "response_json": json.dumps(values["response_json"]),
