+def _insert_delivery_read_ledger(connection, values):
+    """Write V2 ledger on both the pre-return and return-lifecycle schemas.
+
+    This only records cloud ledger metadata. It neither claims nor sends a return.
+    """
+    if connection.dialect.name != "postgresql":
+        connection.execute(delivery_read_operation.insert().values(**values))
+        return
+    has_return_lifecycle = connection.execute(text("""
+        SELECT EXISTS (
+            SELECT 1 FROM information_schema.columns
+             WHERE table_schema = 'public'
+               AND table_name = 'delivery_read_operation'
+               AND column_name = 'return_payload_hash'
+        )
+    """)).scalar_one()
+    if not has_return_lifecycle:
+        connection.execute(delivery_read_operation.insert().values(**values))
+        return
+    connection.execute(text("""
+        INSERT INTO delivery_read_operation (
+            tenant_id, operation_guid, driver_guid, manifest_guid, stop_id, order_id,
