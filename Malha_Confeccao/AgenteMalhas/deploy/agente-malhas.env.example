# Copiar fora do repositorio, por exemplo em:
# C:\ProgramData\ParmaSoft\AgenteMalhas\agente-malhas.env
# Nunca versionar este arquivo nem inserir valores reais neste exemplo.
# A ACL deve permitir leitura apenas para a conta dedicada do Agente e administradores autorizados.
MALHAS_AGENT_API_URL=https://malhas.parmatech.com.br
MALHAS_AGENT_TOKEN=GERAR_E_GUARDAR_FORA_DO_GIT
MALHAS_AGENT_EMPRESA_ID=1
MALHAS_AGENT_EMPRESA_NOME=TEKNO PRIME
FB_HOST=127.0.0.1
FB_PORT=3050
FB_DATABASE=C:\CAMINHO\AUTORIZADO\DADOS.FDB
FB_USER=USUARIO_DEDICADO_DO_AGENTE
FB_PASSWORD=GUARDAR_FORA_DO_GIT
FB_CHARSET=ISO8859_1
MALHAS_AGENT_STATE_PATH=C:\ProgramData\ParmaSoft\AgenteMalhas\state.db
MALHAS_AGENT_LOG_PATH=C:\ProgramData\ParmaSoft\AgenteMalhas\logs\agente-malhas.log
MALHAS_AGENT_LOG_MAX_BYTES=5242880
MALHAS_AGENT_LOG_BACKUP_COUNT=5
MALHAS_AGENT_STOP_FILE=C:\ProgramData\ParmaSoft\AgenteMalhas\stop.request
MALHAS_AGENT_RETRY_SECONDS=10

# Somente para testes locais explicitamente autorizados em loopback.
# Nunca definir em operacao externa.
# MALHAS_AGENT_ALLOW_INSECURE_LOCAL_TESTS=1
